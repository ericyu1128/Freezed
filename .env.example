# Copy to .env.local for local development. In Vercel, set these under
# Project → Settings → Environment Variables (NEXT_PUBLIC_* values are inlined
# at build time, so redeploy after changing them).

# Show outbound retailer links on gear cards. Anything other than false/0/off/no shows them.
NEXT_PUBLIC_SHOW_RETAILER_LINKS=true

# PostHog product analytics. Leave the key empty to disable analytics entirely
# (the app then sends nothing and logs nothing). Host defaults to the US cloud;
# use https://eu.i.posthog.com for an EU project.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
